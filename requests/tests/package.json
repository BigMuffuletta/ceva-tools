{
  "name": "ceva-requests-rules-tests",
  "private": true,
  "type": "module",
  "description": "Checks requests/firestore.rules against the Firestore emulator. Needs Node 18+ and Java 11+.",
  "scripts": {
    "test": "firebase --config ../firebase.json emulators:exec --only firestore --project demo-ceva-requests \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.0.0"
  }
}
