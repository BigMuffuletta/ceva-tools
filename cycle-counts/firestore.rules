rules_version = '2';

// Cycle count requests — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Who can do what is set by roles/{uid}:
//   customer → { role: 'customer', account: 'Northwind Apparel', name }
//              Requests counts and sees only its own account's counts, results and replies.
//              Approves the difference (or asks for a recount) once CEVA posts results.
//   agent    → CEVA team. Sees every account; schedules, counts, posts results, completes.
//   admin    → CEVA admin. Also manages people and settings.
// Anyone signed in without a role can only ask for access (access/{uid}).
//
// A count request holds what to count (lines: product, storage bin, batch, UoM, book qty from EWM)
// and what was found (results, written by CEVA only). Counts are numbered from counters/requests
// in the same transaction (CC-1001, CC-1002, ...).
// Replies the customer sees live in requests/{id}/thread; CEVA-only notes in requests/{id}/internal.
// Neither can be edited or deleted, so the history stays intact.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function rolePath()   { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function hasRole()    { return signedIn() && exists(rolePath()); }
    function me()         { return get(rolePath()).data; }
    function isStaff()    { return hasRole() && me().role in ['agent', 'admin']; }
    function isAdmin()    { return hasRole() && me().role == 'admin'; }
    function isCustomer() { return hasRole() && me().role == 'customer' && me().get('account', '') is string && me().get('account', '') != ''; }
    function myAccount()  { return me().account; }
    function counterPath() { return /databases/$(database)/documents/counters/requests; }

    function text(v, max)   { return v is string && v.size() <= max; }
    function filled(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function numOrNull(v)   { return v == null || v is number; }
    function dateOrBlank(v) { return v == '' || (v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')); }

    function validRequest(d) {
      let keys = ['account', 'reason', 'priority', 'subject', 'details', 'refs', 'neededBy',
                  'status', 'owner', 'resolution', 'source',
                  'createdAt', 'createdBy', 'createdByName', 'createdByEmail', 'updatedAt',
                  'closedAt', 'firstResponseAt', 'lastReplyAt', 'lastReplyBy',
                  'lines', 'results', 'piDoc', 'scheduledFor', 'countedAt',
                  'approval', 'approvalBy', 'approvalAt'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && filled(d.account, 60) && text(d.reason, 80)
        && d.priority in ['normal', 'high', 'urgent']
        && filled(d.subject, 120) && text(d.details, 4000) && text(d.refs, 300)
        && dateOrBlank(d.neededBy) && dateOrBlank(d.scheduledFor)
        && d.status in ['new', 'scheduled', 'counting', 'review', 'approved', 'closed']
        && text(d.owner, 60) && text(d.resolution, 2000)
        && d.source in ['portal', 'ceva']
        && d.createdAt is number && d.updatedAt is number
        && filled(d.createdBy, 128) && text(d.createdByName, 60) && text(d.createdByEmail, 120)
        && numOrNull(d.closedAt) && numOrNull(d.firstResponseAt) && numOrNull(d.lastReplyAt)
        && d.lastReplyBy in ['', 'customer', 'ceva']
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 200
        && d.results is list && d.results.size() <= 300
        && text(d.piDoc, 60) && numOrNull(d.countedAt)
        && d.approval in ['', 'approved', 'recount'] && text(d.approvalBy, 60) && numOrNull(d.approvalAt);
    }

    // The running count number. Only ever goes up by one, together with the new request.
    match /counters/requests {
      allow read: if isStaff() || isCustomer();
      allow create: if (isStaff() || isCustomer())
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1001
        && existsAfter(/databases/$(database)/documents/requests/1001);
      allow update: if (isStaff() || isCustomer())
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && existsAfter(/databases/$(database)/documents/requests/$(string(request.resource.data.n)));
    }

    match /requests/{rid} {
      allow read: if isStaff() || (isCustomer() && resource.data.account == myAccount());

      allow create: if validRequest(request.resource.data)
        && rid == string(getAfter(counterPath()).data.n)
        && request.resource.data.createdBy == request.auth.uid
        && (isStaff() || (isCustomer()
              && request.resource.data.account == myAccount()
              && request.resource.data.status == 'new'
              && request.resource.data.source == 'portal'
              && request.resource.data.owner == ''
              && request.resource.data.resolution == ''
              && request.resource.data.closedAt == null
              && request.resource.data.firstResponseAt == null
              && request.resource.data.lastReplyAt == null
              && request.resource.data.lastReplyBy == ''
              && request.resource.data.results.size() == 0
              && request.resource.data.scheduledFor == ''
              && request.resource.data.countedAt == null
              && request.resource.data.approval == ''
              && request.resource.data.approvalBy == ''
              && request.resource.data.approvalAt == null));

      // CEVA can change anything but who created it and when.
      // A customer can only (a) record a reply, or (b) when results are waiting for approval,
      // approve the difference or send it back for a recount. Lines and results stay as they are.
      allow update: if validRequest(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (isStaff() || (isCustomer()
              && resource.data.account == myAccount()
              && resource.data.status != 'closed'
              && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastReplyAt', 'lastReplyBy'])
                   && request.resource.data.lastReplyBy == 'customer')
                  || (resource.data.status == 'review'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approval', 'approvalBy', 'approvalAt', 'updatedAt', 'lastReplyAt', 'lastReplyBy'])
                   && request.resource.data.approvalAt is number
                   && filled(request.resource.data.approvalBy, 60)
                   && (request.resource.data.lastReplyBy == resource.data.lastReplyBy || request.resource.data.lastReplyBy == 'customer')
                   && ((request.resource.data.status == 'approved' && request.resource.data.approval == 'approved')
                       || (request.resource.data.status == 'counting' && request.resource.data.approval == 'recount'))))));

      allow delete: if isAdmin();

      function parent() { return get(/databases/$(database)/documents/requests/$(rid)).data; }
      function validNote(d) {
        let keys = ['text', 'at', 'by', 'byName', 'side', 'kind'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && filled(d.text, 2000) && d.at is number
          && d.by == request.auth.uid && text(d.byName, 60)
          && d.kind in ['msg', 'status'];
      }

      // Replies and status changes the customer sees.
      match /thread/{nid} {
        allow read: if isStaff() || (isCustomer() && parent().account == myAccount());
        allow create: if validNote(request.resource.data) && (
          (isStaff() && request.resource.data.side == 'ceva')
          || (isCustomer()
              && request.resource.data.side == 'customer'
              && request.resource.data.kind == 'msg'
              && parent().account == myAccount()
              && parent().status != 'closed'));
      }

      // CEVA-only notes. Customers can never read these.
      match /internal/{nid} {
        allow read: if isStaff();
        allow create: if isStaff() && validNote(request.resource.data)
          && request.resource.data.side == 'ceva' && request.resource.data.kind == 'msg';
      }
    }

    // Portal name, count reasons, targets, approval setting, counter names.
    match /config/{docId} {
      allow read: if hasRole();
      allow write: if isAdmin() && request.resource.data.size() <= 30;
    }

    // Who can use the portal. Each person can read their own role.
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'name', 'account', 'email', 'updatedAt'])
        && request.resource.data.role in ['customer', 'agent', 'admin']
        && text(request.resource.data.get('name', ''), 60)
        && text(request.resource.data.get('email', ''), 120)
        && (request.resource.data.role != 'customer' || filled(request.resource.data.get('account', ''), 60))
        && (uid != request.auth.uid || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // "Let me in" requests from people who created an account. Admins approve or dismiss them.
    match /access/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'company', 'email', 'at'])
        && filled(request.resource.data.name, 60)
        && text(request.resource.data.company, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at is number;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
